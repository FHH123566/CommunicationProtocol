<UserControl x:Class="CommunicationProtocol.WPF.Views.ProtocolView"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:vm="clr-namespace:CommunicationProtocol.WPF.ViewModels"
xmlns:pv="clr-namespace:CommunicationProtocol.WPF.Views.ProtocolViews">
<Grid Margin="10">
<Grid.RowDefinitions>
<RowDefinition Height="Auto"/>
<RowDefinition Height="Auto"/>
<RowDefinition Height="*"/>
</Grid.RowDefinitions>
<ComboBox ItemsSource="{Binding ProtocolNames}" SelectedItem="{Binding SelectedProtocol}" Width="200" Margin="0,0,0,10"/>
<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
<Button Content="Connect" Command="{Binding ConnectCommand}" Width="80" Margin="0,0,10,0"/>
<Button Content="Disconnect" Command="{Binding DisconnectCommand}" Width="80"/>
</StackPanel>
<ContentControl Grid.Row="2" Content="{Binding CurrentViewModel}">
<ContentControl.Resources>
<DataTemplate DataType="{x:Type vm:ModbusViewModel}">
<pv:ModbusView/>
</DataTemplate>
<DataTemplate DataType="{x:Type vm:S7ViewModel}">
<pv:S7View/>
</DataTemplate>
<DataTemplate DataType="{x:Type vm:OpcUaViewModel}">
<pv:OpcUaView/>
</DataTemplate>
<DataTemplate DataType="{x:Type vm:EtherNetIpViewModel}">
<pv:EtherNetIpView/>
</DataTemplate>
</ContentControl.Resources>
</ContentControl>
</Grid>
</UserControl>
